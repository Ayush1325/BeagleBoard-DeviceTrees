/dts-v1/;
/plugin/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

&main_spi2 {
	#address-cells = <1>;
	#size-cells = <0>;

	adafruit18: adafruit18@0{
		compatible = "jianda,jd-t18003-t01";
		pinctrl-names = "default";
		pinctrl-0 = <&P2_19_gpio &P2_17_gpio>;
		reg = <0>;
		dc-gpios = <&main_gpio0 64 0>;
		backlight = <&ecap2 0 255 0>;
		spi-max-frequency = <32000000>;
		reset-gpios = <&main_gpio1 0 0>;
                rotation = <0>;
		buswidth = <8>;
	};
};

&{/} {
	cape-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&P1_04_D20_gpio &P2_03_B18_gpio>;

		led-1 {
			gpios = <&main_gpio1 12 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_RED>;
		};

		led-2 {
			gpios = <&main_gpio1 9 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_RED>;
		};
	};


	buttons {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&P2_06_gpio &P2_02_gpio &P2_08_gpio &P2_04_gpio &P1_31_gpio
			     &P2_22_gpio &P2_18_gpio &P2_24_gpio &P2_20_gpio &P1_35_gpio>;

		left-top {
			label = "D-PAD UP";
			gpios = <&main_gpio0 47 GPIO_ACTIVE_LOW>;
        		linux,code = <BTN_FORWARD>;
		};
		left-left {
			label = "D-PAD LEFT";
			gpios = <&main_gpio0 48 GPIO_ACTIVE_LOW>;
        		linux,code = <BTN_LEFT>;
		};
		left-bottom {
			label = "D-PAD DOWN";
			gpios = <&main_gpio0 45 GPIO_ACTIVE_LOW>;
        		linux,code = <BTN_BACK>;
		};
		left-right {
			label = "D-PAD RIGHT";
			gpios = <&main_gpio0 46 GPIO_ACTIVE_LOW>;
        		linux,code = <BTN_RIGHT>;
		};

		right-top {
			label = "ACTION-PAD NORTH";
			gpios = <&main_gpio0 63 GPIO_ACTIVE_LOW>;
        		linux,code = <BTN_NORTH>;
		};
		right-left {
			label = "ACTION-PAD WEST";
			gpios = <&main_gpio0 51 GPIO_ACTIVE_LOW>;
        		linux,code = <BTN_WEST>;
		};
		right-bottom {
			label = "ACTION-PAD SOUTH";
			gpios = <&main_gpio0 53 GPIO_ACTIVE_LOW>;
        		linux,code = <BTN_SOUTH>;
		};
		right-right {
			label = "ACTION-PAD EAST";
			gpios = <&main_gpio0 49 GPIO_ACTIVE_LOW>;
        		linux,code = <BTN_EAST>;
		};

		start {
			label = "START";
			gpios = <&main_gpio0 88 GPIO_ACTIVE_LOW>;
        		linux,code = <BTN_START>;
		};
		select {
			label = "SELECT";
			gpios = <&main_gpio0 59 GPIO_ACTIVE_LOW>;
        		linux,code = <BTN_SELECT>;
		};
	};

	buzzer {
        	compatible = "pwm-beeper";
		pinctrl-names = "default";
		pinctrl-0 = <&P1_33_A17_pwm>;
		pwms = <&epwm2 1 255 0>;
	};
};
